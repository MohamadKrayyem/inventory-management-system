# Copy this file to .env and replace every value. .env is in .gitignore and is never committed.

# SQL Server "sa" password. SQL Server requires 8+ characters with upper case, lower case and a digit or symbol.
# Do not use ; or $ (they break the connection string below).
MSSQL_SA_PASSWORD=Replace-With-A-Strong-Password-1

# Connection string the API uses. "db" is the SQL Server service name in docker-compose.yml.
DB_CONNECTION_STRING=Server=db,1433;Database=InventoryDb;User Id=sa;Password=${MSSQL_SA_PASSWORD};TrustServerCertificate=True

# JWT signing key, at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_KEY=replace-with-a-long-random-secret-of-at-least-32-chars

# Host ports (optional)
WEB_PORT=5173
API_PORT=5000
DB_PORT=1433
